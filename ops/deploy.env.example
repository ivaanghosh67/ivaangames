# Machine-local deploy settings. Copy to ops/deploy.env and edit.
#
#   cp ops/deploy.env.example ops/deploy.env
#
# ops/deploy.env is gitignored. Put the PATH to the deploy key here — never the
# key itself, and never the key file inside this repository: it is public, and
# the deploy path runs `git add -A`.

IRONLINE_DEPLOY_KEY=/path/to/buildwithsumit.pem
